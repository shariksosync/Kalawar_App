# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/wsf_db?retryWrites=true&w=majority
# (Optional) Direct Replica Set fallback URI for ISP/DNS SRV-restricted environments
# MONGODB_DIRECT_URI=mongodb://<username>:<password>@node1:27017,node2:27017/wsf_db?ssl=true&replicaSet=atlas-xxx&authSource=admin

# ==============================================================================
# ADMIN AUTHENTICATION
# ==============================================================================
ADMIN_EMAIL=admin@kalawarfederation.org
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=your_64_character_random_hex_session_secret

# ==============================================================================
# CLOUDINARY ASSET STORAGE
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# TRANSACTIONAL SMTP EMAIL (NODEMAILER)
# ==============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
SMTP_SECURE=false
SMTP_FROM="KALAWAR Federation" <your_email@gmail.com>

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY
# ==============================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# ==============================================================================
# PUBLIC APPLICATION CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_APP_URL=https://kalawarindia.org
NODE_ENV=production

# ==============================================================================
# OPTIONAL INTEGRATIONS
# ==============================================================================
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
